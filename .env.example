# Keys for pipeline/.env (gitignored), all read by the pipeline. Without them it runs offline on the cached call data.
# Claude extracts claims and judges novelty (claude-sonnet-5-5), else the rules run.
ANTHROPIC_API_KEY=
# 1-minute bars from Massive (formerly Polygon), required for ingest.
POLYGON_API_KEY=
# Analyst consensus (25 requests a day), else no estimates.
ALPHA_VANTAGE_KEY=
# Supabase project URL, for publishing, the audio upload and the worker.
SUPABASE_URL=
# Supabase service key, never exposed to the browser.
SUPABASE_SERVICE_KEY=
# Hugging Face token for pyannote speaker diarization on the CPU path.
HF_TOKEN=
# Modal token id, set to run transcription and diarization on a Modal GPU.
MODAL_TOKEN_ID=
# Modal token secret, paired with the token id.
MODAL_TOKEN_SECRET=
# Contact User-Agent that SEC EDGAR requires for worker downloads from sec.gov.
SEC_USER_AGENT=
